# Copy to .env.local for local development. Keep real secrets out of Git.
# Set the same values in Vercel > Project Settings > Environment Variables.

# Choose smtp or resend. Sending to this inbox does not require a custom domain.
MAIL_PROVIDER=smtp
CONTACT_TO_EMAIL=8174245usama@gmail.com
MAIL_FROM=8174245usama@gmail.com

# SMTP provider: 465 uses TLS; 587 uses STARTTLS.
# Gmail needs 2-Step Verification plus an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=8174245usama@gmail.com
SMTP_PASS=

# Alternative: MAIL_PROVIDER=resend, a verified-domain MAIL_FROM and this key.
RESEND_API_KEY=

# Create a Cloudflare Turnstile Managed widget for your live domain.
# Both keys are required before live form submissions are enabled.
# The site key is public; the secret key must NEVER use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
